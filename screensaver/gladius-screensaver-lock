#!/bin/bash
# ==============================================================================
# WARHAMMER 40,000 GLADIUS SUPREME UNIFIED SCREENSAVER DISPATCHER
#
# Features:
#   - Synchronized Multi-Monitor Display (DP-1, DP-2, DP-3)
#   - 11 Faction & Race Cinematic Episodes (Human Factions first, then Alphabetical)
#   - Grim Dark enhanced colors, bombastic voice acting, and official theme scores
#   - Timed sequences ending with fierce hero declarations
#   - Frame-Accurate Simultaneous Multi-Screen Launch
#   - Secure Zero-Exposure Lock Dismissal (No Desktop Flashing)
# ==============================================================================

# If already locked, do not re-trigger
if [[ $(omarchy-shell lock isLocked 2>/dev/null) == "true" ]]; then
  exit 0
fi

# Clean up any lingering screensaver instances for a clean start
killall -q mpv 2>/dev/null || true
pkill -f '[g]ladius-battle-chatter' 2>/dev/null || true

RUNNER="$HOME/.local/bin/gladius-screensaver-runner"
if [[ ! -x "$RUNNER" ]]; then
  exit 1
fi

focused=$(omarchy-hyprland-monitor-focused 2>/dev/null || echo "DP-3")

# 1. Generate the authoritative 11-faction playlist:
# Human factions first (alphabetical), then all other races/factions alphabetically
python3 -c "
import os

DATA_DIR = os.path.expanduser('~/.local/share/gladius_screensaver')
FACTION_DIR = f'{DATA_DIR}/factions'
PLAYLIST_FILE = f'{DATA_DIR}/playlist.m3u'

ordered_factions = [
    # Human Factions first (alphabetical)
    f'{FACTION_DIR}/01_adepta_sororitas.mp4',
    f'{FACTION_DIR}/02_adeptus_mechanicus.mp4',
    f'{FACTION_DIR}/03_astra_militarum.mp4',
    f'{FACTION_DIR}/04_space_marines.mp4',
    # All other factions alphabetically
    f'{FACTION_DIR}/05_aeldari.mp4',
    f'{FACTION_DIR}/06_chaos_space_marines.mp4',
    f'{FACTION_DIR}/07_drukhari.mp4',
    f'{FACTION_DIR}/08_necrons.mp4',
    f'{FACTION_DIR}/09_orks.mp4',
    f'{FACTION_DIR}/10_tau.mp4',
    f'{FACTION_DIR}/11_tyranids.mp4'
]

with open(PLAYLIST_FILE, 'w') as fp:
    for item in ordered_factions:
        if os.path.isfile(item):
            fp.write(f'{item}\n')
"

# 2. Dispatch simultaneously to each monitor's visible workspace
python3 -c "
import subprocess, json, time, os

res = subprocess.run(['hyprctl', 'monitors', '-j'], capture_output=True, text=True)
monitors = json.loads(res.stdout)
focused = '$focused'
runner = os.path.expanduser('~/.local/bin/gladius-screensaver-runner')

for m in monitors:
    m_name = m['name']
    ws_id = m['activeWorkspace']['id']
    audio_flag = '--volume=95' if m_name == focused else '--mute=yes'
    cmd = f'hl.dsp.exec_cmd([[[workspace {ws_id}] {runner} {m_name} {audio_flag}]])'
    subprocess.run(['hyprctl', 'dispatch', cmd], capture_output=True)
    time.sleep(0.04)
"
